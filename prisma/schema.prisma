generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  USER
  CONTENT_EDITOR
  ADMIN
  OWNER
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum LessonType {
  VOCABULARY
  GRAMMAR
  CONVERSATION
}

enum ExerciseType {
  MULTIPLE_CHOICE
  ARRANGE_WORDS
  MATCHING
  TRANSLATE
}

enum ProgressStatus {
  AVAILABLE
  IN_PROGRESS
  COMPLETED
}

model User {
  id                 String                @id @default(cuid())
  name               String
  email              String                @unique
  passwordHash       String
  role               UserRole              @default(USER)
  locale             String                @default("ru")
  xp                 Int                   @default(0)
  streak             Int                   @default(0)
  longestStreak      Int                   @default(0)
  lastActivityDate   DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  preference         UserPreference?
  sessions           Session[]
  courses            UserCourse[]
  lessonProgress     UserLessonProgress[]
  attempts           UserExerciseAttempt[]
  aiAssistantSessions AiAssistantSession[]
  aiTutorMemories    AiTutorMemory[]
  aiProviderLogs     AiProviderLog[]
  aiUsageCosts       AiUsageCost[]

  @@index([role])
  @@index([createdAt])
}

model UserPreference {
  userId               String  @id
  sourceLanguage       String  @default("ru")
  targetLanguage       String  @default("uz")
  dailyGoalMinutes     Int     @default(10)
  notificationsEnabled Boolean @default(true)
  timezone             String  @default("Asia/Tashkent")
  theme                 String  @default("system")
  soundEnabled          Boolean @default(true)
  soundVolume           Float   @default(0.7)
  effectsEnabled        Boolean @default(true)
  lessonSoundsEnabled   Boolean @default(true)
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Course {
  id             String              @id @default(cuid())
  slug           String              @unique
  sourceLanguage String
  targetLanguage String
  level          String
  status         CourseStatus        @default(DRAFT)
  coverImageUrl  String?
  order          Int                 @default(0)
  isPremium      Boolean             @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  translations   CourseTranslation[]
  modules        Module[]
  enrollments    UserCourse[]

  @@index([status, sourceLanguage, targetLanguage])
  @@index([order])
}

model CourseTranslation {
  courseId    String
  locale      String
  title       String
  description String
  course      Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([courseId, locale])
  @@index([locale])
}

model Module {
  id           String              @id @default(cuid())
  courseId     String
  order        Int                 @default(0)
  status       ContentStatus       @default(DRAFT)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  course       Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  translations ModuleTranslation[]
  lessons      Lesson[]

  @@unique([courseId, order])
  @@index([courseId, status])
}

model ModuleTranslation {
  moduleId    String
  locale      String
  title       String
  description String @default("")
  module      Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([moduleId, locale])
  @@index([locale])
}

model Lesson {
  id               String               @id @default(cuid())
  moduleId         String
  type             LessonType           @default(VOCABULARY)
  order            Int                  @default(0)
  xpReward         Int                  @default(20)
  estimatedMinutes Int                  @default(5)
  status           ContentStatus        @default(DRAFT)
  videoUrl         String?
  audioUrl         String?
  thumbnailUrl     String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  module           Module               @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  translations     LessonTranslation[]
  exercises        Exercise[]
  progress         UserLessonProgress[]

  @@unique([moduleId, order])
  @@index([moduleId, status])
  @@index([updatedAt])
}

model LessonTranslation {
  lessonId   String
  locale     String
  title      String
  description String @default("")
  theory     String @default("")
  lesson     Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([lessonId, locale])
  @@index([locale])
}

model Exercise {
  id           String                @id @default(cuid())
  lessonId     String
  type         ExerciseType
  order        Int                   @default(0)
  xpReward     Int                   @default(5)
  payload      String                @default("{}")
  status       ContentStatus         @default(DRAFT)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  lesson       Lesson                @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  translations ExerciseTranslation[]
  options      ExerciseOption[]
  attempts     UserExerciseAttempt[]

  @@unique([lessonId, order])
  @@index([lessonId, status])
}

model ExerciseTranslation {
  exerciseId  String
  locale      String
  instruction String
  question    String @default("")
  explanation String @default("")
  exercise    Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([exerciseId, locale])
  @@index([locale])
}

model ExerciseOption {
  id           String                      @id @default(cuid())
  exerciseId   String
  order        Int                         @default(0)
  isCorrect    Boolean                     @default(false)
  exercise     Exercise                    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  translations ExerciseOptionTranslation[]

  @@unique([exerciseId, order])
  @@index([exerciseId])
}

model ExerciseOptionTranslation {
  optionId String
  locale   String
  text     String
  option   ExerciseOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([optionId, locale])
  @@index([locale])
}

model UserCourse {
  id          String   @id @default(cuid())
  userId      String
  courseId    String
  enrolledAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
}

model UserLessonProgress {
  id                 String         @id @default(cuid())
  userId             String
  lessonId           String
  status             ProgressStatus @default(AVAILABLE)
  completedExercises Int            @default(0)
  correctAnswers     Int            @default(0)
  attempts           Int            @default(0)
  startedAt          DateTime?
  completedAt        DateTime?
  earnedXp           Int            @default(0)
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson             Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  exerciseAttempts   UserExerciseAttempt[]

  @@unique([userId, lessonId])
  @@index([userId, status])
  @@index([lessonId])
}

model UserExerciseAttempt {
  id               String             @id @default(cuid())
  userId           String
  exerciseId       String
  lessonProgressId String
  submittedAnswer  String
  isCorrect        Boolean
  xpEarned         Int                @default(0)
  attemptedAt      DateTime           @default(now())
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise         Exercise           @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  lessonProgress   UserLessonProgress @relation(fields: [lessonProgressId], references: [id], onDelete: Cascade)

  @@index([userId, exerciseId])
  @@index([lessonProgressId])
}

model AiAssistantSession {
  id             String               @id @default(cuid())
  userId         String
  feature        String               @default("tutor")
  direction      String
  nativeLanguage String
  targetLanguage String
  level          String
  topic          String
  status         String               @default("ACTIVE")
  startedAt      DateTime             @default(now())
  finishedAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       AiAssistantMessage[]
  providerLogs   AiProviderLog[]
  usageCosts     AiUsageCost[]

  @@index([userId, createdAt])
  @@index([userId, status])
}

model AiAssistantMessage {
  id                 String             @id @default(cuid())
  sessionId          String
  clientMessageId    String?
  role               String
  recognizedText     String?
  correctedText      String?
  translation        String?
  grammarExplanation String?
  teacherReply       String?
  nextQuestion       String?
  score              Int?
  xp                 Int                @default(0)
  coins              Int                @default(0)
  audioUrl            String?
  responseJson       String?
  createdAt          DateTime           @default(now())
  session            AiAssistantSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, clientMessageId])
  @@index([sessionId, createdAt])
}

model AiTutorMemory {
  id                   String          @id @default(cuid())
  userId               String
  direction            String
  nativeLanguage       String
  targetLanguage       String
  level                String
  summary              String          @default("")
  weakTopicsJson       String          @default("[]")
  frequentMistakesJson String          @default("[]")
  recentTopicsJson     String          @default("[]")
  coins                Int             @default(0)
  lastSessionId        String?
  lastLessonAt         DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  learnedWords         AiLearnedWord[]

  @@unique([userId, direction])
  @@index([userId, updatedAt])
}

model AiLearnedWord {
  id             String        @id @default(cuid())
  memoryId       String
  word           String
  normalizedWord String
  translation    String
  language       String
  timesSeen      Int           @default(1)
  mastery        Int           @default(0)
  lastSeenAt     DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  memory         AiTutorMemory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@unique([memoryId, language, normalizedWord])
  @@index([memoryId, lastSeenAt])
}

model AiProviderLog {
  id           String              @id @default(cuid())
  providerType String
  providerName String
  model        String
  success      Boolean
  latencyMs    Int
  errorCode    String?
  requestId    String
  sessionId    String?
  userId       String
  createdAt    DateTime            @default(now())
  session      AiAssistantSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([userId, createdAt])
  @@index([providerType, providerName, createdAt])
  @@index([requestId])
}

model AiUsageCost {
  id            String              @id @default(cuid())
  userId        String
  sessionId     String?
  providerType  String
  providerName  String
  model         String
  inputUnits    Int?
  outputUnits   Int?
  estimatedCost Float?
  currency      String              @default("USD")
  requestId     String
  createdAt     DateTime            @default(now())
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  session       AiAssistantSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
  @@index([providerType, providerName, model])
  @@index([requestId])
}
