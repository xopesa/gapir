{
  "name": "gapir-web",
  "version": "1.3.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "prisma generate",
    "db:migrate": "tsx prisma/migrate.ts",
    "db:migrate:prisma": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "cf:build": "node scripts/cf-build.mjs",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "cf:migrations": "node scripts/d1-migrations.mjs",
    "cf:typegen": "node scripts/cf-typegen.mjs",
    "db:migrate:d1:local": "wrangler d1 migrations apply gapir-db --local",
    "db:migrate:d1:remote": "wrangler d1 migrations apply gapir-db --remote",
    "db:seed:d1:local": "cross-env SEED_TARGET=d1-local tsx prisma/seed.ts",
    "db:seed:d1:remote": "cross-env SEED_TARGET=d1-remote tsx prisma/seed.ts",
    "prompts:build": "node scripts/build-prompts.mjs",
    "audio:generate": "tsx scripts/generate-audio.ts"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@hookform/resolvers": "^5.5.7",
    "@opennextjs/cloudflare": "^1.20.16",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/adapter-d1": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tanstack/react-query": "^5.101.4",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.43.0",
    "next": "^16.4.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.83.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "cross-env": "^10.1.0",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.4.6",
    "prisma": "^7.10.1",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.160.0"
  },
  "type": "module",
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "unrs-resolver@1.11.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true,
    "workerd@1.20261110.1": true
  }
}
