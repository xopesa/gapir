DATABASE_URL="file:./dev.db"
ADMIN_EMAIL="owner@gapir.local"
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_NAME="Gapir Owner"
SESSION_TTL_DAYS="30"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Gapir AI Assistant feature flags. Mock providers are safe for local development.
ENABLE_AI_ASSISTANT="true"
ENABLE_AI_TUTOR="true"
ENABLE_AI_VOICE_INPUT="true"
ENABLE_AI_TRANSLATION="false"
ENABLE_AI_GRAMMAR="false"
ENABLE_AI_PRONUNCIATION="false"
ENABLE_AI_VOCABULARY="false"
ENABLE_AI_OFFLINE="false"
ENABLE_AI_LOCAL_STT="false"
ENABLE_AI_LOCAL_TTS="false"

# Stage 3.3 provider routing. Safe defaults remain mock.
AI_STT_PROVIDER="mock"
AI_STT_MODEL="mock-stt-v1"
AI_STT_UZ_PROVIDER="mock"
AI_STT_UZ_MODEL="mock-stt-v1"
AI_STT_ZH_PROVIDER="mock"
AI_STT_ZH_MODEL="mock-stt-v1"
AI_LLM_PROVIDER="mock"
AI_LLM_MODEL="mock-llm-v1"
AI_TTS_PROVIDER="mock"
AI_TTS_MODEL="mock-tts-v1"
AI_TTS_UZ_PROVIDER="disabled"
AI_TTS_UZ_MODEL="none"
AI_TTS_ZH_PROVIDER="disabled"
AI_TTS_ZH_MODEL="none"
AI_TRANSLATION_PROVIDER="mock"

# OpenAI-compatible LLM. For Gemini use provider=gemini and the official base URL below.
# Never commit a real key and never expose it through NEXT_PUBLIC_* variables.
AI_LLM_API_KEY=""
AI_LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
# Legacy OpenAI-specific variables remain supported.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"

# Optional external OpenAI-compatible TTS.
AI_TTS_API_KEY=""
AI_TTS_BASE_URL="https://api.openai.com/v1"
AI_TTS_VOICE="alloy"

# Local workers. Set AI_STT_MODEL_PATH in the worker shell, not in browser code.
AI_STT_WORKER_URL="http://127.0.0.1:8101"
AI_TTS_WORKER_URL="http://127.0.0.1:8102"
AI_WORKER_HOST="127.0.0.1"
AI_STT_WORKER_PORT="8101"
AI_TTS_WORKER_PORT="8102"
AI_TTS_WORKER_ENABLED="false"
AI_LOCAL_MODEL_DIR=""
AI_STT_MODEL_PATH=""
AI_STT_DEVICE="cpu"
AI_STT_COMPUTE_TYPE="int8"
AI_STT_CPU_THREADS="4"
AI_STT_MAX_CONCURRENCY="1"
AI_STT_TIMEOUT_SECONDS="120"

# Limits, resilience and pricing configuration.
AI_PROVIDER_TIMEOUT_MS="20000"
AI_WORKER_TIMEOUT_MS="120000"
AI_PROVIDER_MAX_RETRIES="1"
AI_MAX_AUDIO_BYTES="15728640"
AI_MAX_AUDIO_DURATION_MS="60000"
AI_AUDIO_MAX_SECONDS="60"
AI_MAX_MESSAGES_PER_SESSION="40"
AI_RATE_LIMIT_PER_MINUTE="20"
AI_MAX_CONCURRENT_TURNS_PER_USER="1"
AI_PRICING_JSON="{}"
