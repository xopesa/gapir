{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gapir.app/schemas/ai-tutor-response.v1.schema.json",
  "title": "Gapir AI Tutor Response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recognizedText", "correctedText", "translation", "grammarExplanation",
    "teacherReply", "nextQuestion", "newWords", "pronunciationTips",
    "grammarTopic", "score", "xp", "coins", "achievements", "audioUrl",
    "latency", "provider", "model", "version"
  ],
  "properties": {
    "recognizedText": { "type": "string", "maxLength": 4000 },
    "correctedText": { "type": "string", "maxLength": 4000 },
    "translation": { "type": "string", "maxLength": 4000 },
    "grammarExplanation": { "type": "string", "maxLength": 6000 },
    "teacherReply": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "nextQuestion": { "type": "string", "maxLength": 2000 },
    "newWords": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["word", "translation", "language"],
        "properties": {
          "word": { "type": "string", "minLength": 1, "maxLength": 200 },
          "translation": { "type": "string", "minLength": 1, "maxLength": 500 },
          "language": { "enum": ["uz", "zh-CN"] }
        }
      }
    },
    "pronunciationTips": { "type": "array", "maxItems": 5, "items": { "type": "string", "maxLength": 1000 } },
    "grammarTopic": { "type": "string", "maxLength": 300 },
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "xp": { "type": "integer", "minimum": 0, "maximum": 1000 },
    "coins": { "type": "integer", "minimum": 0, "maximum": 1000 },
    "achievements": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 100 } },
    "audioUrl": { "type": ["string", "null"], "format": "uri", "maxLength": 3000000 },
    "latency": {
      "type": "object", "additionalProperties": false,
      "required": ["sttMs", "llmMs", "ttsMs", "totalMs"],
      "properties": {
        "sttMs": { "type": "integer", "minimum": 0 },
        "llmMs": { "type": "integer", "minimum": 0 },
        "ttsMs": { "type": "integer", "minimum": 0 },
        "totalMs": { "type": "integer", "minimum": 0 }
      }
    },
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["stt", "llm", "tts"],
      "properties": {
        "stt": { "type": "string", "maxLength": 200 },
        "llm": { "type": "string", "maxLength": 200 },
        "tts": { "type": "string", "maxLength": 200 }
      }
    },
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["stt", "llm", "tts"],
      "properties": {
        "stt": { "type": "string", "maxLength": 300 },
        "llm": { "type": "string", "maxLength": 300 },
        "tts": { "type": "string", "maxLength": 300 }
      }
    },
    "version": { "type": "string", "enum": ["1"] }
  }
}
